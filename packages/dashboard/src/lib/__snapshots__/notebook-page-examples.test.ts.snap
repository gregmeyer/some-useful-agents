exports[`a notebook to meet-company > keeps the same outline unless it was changed on purpose 1`] = `
"Column
  NotebookHeader subtitle=Meeting briefing cover=none steps=fold
  Columns 1:2
    Panel treatment=aside "Their company"
      Column
        ProfileCard
        FactSheet variant=ruled
    Panel treatment=feature "What to talk about"
      Agenda variant=numerals
  Panel treatment=feature "In their words"
    QuoteList max=4
  Columns 1:1
    Disclosure "Research activity"
      Timeline max=6
    Disclosure "Where sua looked"
      Coverage"
`;

