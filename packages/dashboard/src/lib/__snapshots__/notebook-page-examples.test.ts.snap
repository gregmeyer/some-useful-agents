// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a notebook to accounts > keeps the same outline unless it was changed on purpose 1`] = `
"Column
  Columns 2:1
    Column
      Callout "Where it stands"
      StatStrip
    Panel "Done when"
      Steps "Progress"
  Columns 1
    Panel "How far they got"
      Funnel
  Panel "Shortlist"
    OptionGrid
  Columns 1:2
    Panel "Before you decide"
      Checklist
    Panel "How we got here"
      Timeline max=8
  Columns 1:1
    Panel "Where sua looked"
      Coverage
    Panel "Limits"
      ChipList"
`;

